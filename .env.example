# Required for AI analysis features
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables voting record, rebellion stats, and APPG roles
# Get a free key at https://www.theyworkforyou.com/api/key
THEYWORKFORYOU_API_KEY=

# Flask session secret — use any long random string in production
FLASK_SECRET_KEY=change-me-in-production

# Optional — enables Redis caching (Parliament lookups cached 1h, AI analysis 24h)
# Locally: run `redis-server` or leave unset (app works fine without it)
# On Railway: add the Redis plugin and it sets this automatically
REDIS_URL=

# Optional — enables persistent AI analysis storage (28-day TTL, survives restarts)
# Locally: run Postgres or leave unset (app works fine without it)
# On Railway: add the Postgres plugin and it sets this automatically
DATABASE_URL=

# Optional — Cloudflare R2 card image cache (serves cards from CDN, bypasses Flask on repeat requests)
# Set up: cloudflare.com → R2 → create bucket → enable public access → create API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=paidup
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Optional — Langfuse observability (token usage, cost, latency per Claude call)
# Get keys at https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com  # default; set to your self-hosted URL if needed
